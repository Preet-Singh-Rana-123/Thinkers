        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum(rate(django_http_requests_latency_including_middlewares_by_view_method_bundle_seconds_bucket[5m])) by (le))",
          "legendFormat": "50th-Percentile Latency (Median)",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "95th-Percentile HTTP Response Latency",
