# ==============================================================================
# Thinkers Platform - Environment Configuration Template
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-in-production-2026
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx,*.amazonaws.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (MySQL 8.0 / AWS RDS)
DB_HOST=db
DB_PORT=3306
DB_NAME=thinkers_db
DB_USER=thinkers_user
DB_PASSWORD=thinkers_secure_pass_2026

# MySQL Container Initialization
MYSQL_ROOT_PASSWORD=root_master_pass_2026
MYSQL_DATABASE=thinkers_db
MYSQL_USER=thinkers_user
MYSQL_PASSWORD=thinkers_secure_pass_2026

# AWS S3 & CloudFront Configuration (Optional - Production)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=thinkers-cloud-assets-prod
AWS_S3_REGION_NAME=us-east-1

# Monitoring & Alerting
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_pass_2026
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
ALERT_EMAIL_RECIPIENT=devops@thinkers.example.com
